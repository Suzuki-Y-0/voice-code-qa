# ===== 回答するLLM(どちらか一方のキーがあれば動きます) =====
# LLM_PROVIDER=opencode      # opencode(既定) か claude

# --- OpenCode Go(既定) ---
OPENCODE_API_KEY=            # OpenCode Goのキー
# OPENCODE_MODEL=mimo-v2.6-flash   # python bot.py --check で一覧と速度を確認できる

# --- Claude(Anthropic API) ---
# LLM_PROVIDER=claude を有効にして、下のキーを記入
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5    # 速さ重視。より賢くしたいときは別のClaudeモデルに

# ===== 音声(下は既定値) =====
# WHISPER_MODEL=large-v3-turbo   # 速さ重視なら small。手元のfaster-whisperモデルのフォルダも指定できる
# WHISPER_DEVICE=auto            # GPUで落ちるときは cpu
# TTS_VOICE=                     # Windowsの音声名の一部(例 Haruka)。空なら日本語の音声を自動選択
# TTS_RATE=2                     # 話す速さ。-10(遅い)〜10(速い)
# LOG_LEVEL=INFO                 # DEBUGで詳細ログ
